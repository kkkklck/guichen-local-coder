HOST=127.0.0.1
PORT=3000
ADMIN_PORT=3001
# Use scripts/setup.mjs to generate local tokens; never publish .env.
MCP_TOKEN=
ADMIN_TOKEN=
# Exactly one ordinary directory, including its ordinary descendants.
WORKSPACE_PATH=./workspace
CHATGPT_TOOL_PROFILE=slim
# trusted explicitly opts into unsandboxed execution with your user permissions.
SHELL_GUARD_MODE=approval
SHELL_TIMEOUT=120
AUDIT_LOG_PATH=.mcp-audit.log
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880
MCP_SESSION_RECOVERY=true
MCP_SESSION_TTL_MS=1800000
MCP_SESSION_MAX=512
MCP_SESSION_RECOVERY_TIMEOUT_MS=10000
# Existing hooks and upstream integrations are disabled by default.
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json
# Optional trusted executable outside the workspace:
# PDFTOTEXT_PATH=C:/Program Files/poppler/Library/bin/pdftotext.exe
